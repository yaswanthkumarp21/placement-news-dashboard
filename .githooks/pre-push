#!/usr/bin/env bash
# Blocks a push that would publish something this repo must never carry:
# a leaked secret (gitleaks), the maintainer's personal email as an author,
# or names and identifiers that belong to the private downstream site.
# Enable once per clone: git config core.hooksPath .githooks
set -u

remote="$1"
z40=0000000000000000000000000000000000000000
fail=0

# words and identifiers that must not appear in added lines
banned='jonathan\.w\.meyer|ethernewscc|ethernewshq|9e78c599|en_admin|ethernews\.cc'
# the one allowed mention: the README credit line naming the flagship site
allow='ethernews\.org'

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue
  if [ "$remote_sha" = "$z40" ]; then
    # a new branch: scan from where it left the remote default branch, or
    # from the empty tree when nothing on the remote relates to it
    base=$(git merge-base "$local_sha" "refs/remotes/$remote/HEAD" 2>/dev/null || git merge-base "$local_sha" "refs/remotes/$remote/main" 2>/dev/null || echo 4b825dc642cb6eb9a060e54bf8d69288fbee4904)
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  # author emails: only the GitHub noreply address may publish here
  bad_authors=$(git log --format='%ae' "$range" | grep -v 'users\.noreply\.github\.com' | sort -u)
  if [ -n "$bad_authors" ]; then
    echo "pre-push: commit author is not the noreply address: $bad_authors"
    fail=1
  fi

  # added lines carrying private-site identifiers
  hits=$(git diff "$range" -- . ':!.githooks/pre-push' | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -Ei "$banned")
  if [ -n "$hits" ]; then
    echo "pre-push: added lines mention a private identifier:"
    echo "$hits" | head -20
    fail=1
  fi

  # secrets
  if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks git --no-banner --exit-code 1 --log-opts="$range" . >/tmp/gitleaks-prepush.log 2>&1; then
      echo "pre-push: gitleaks found something in $range:"
      tail -30 /tmp/gitleaks-prepush.log
      fail=1
    fi
  else
    echo "pre-push: gitleaks is not installed, refusing to push without a secrets scan"
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo "pre-push: blocked. Fix the commits, or bypass once with --no-verify if you are certain."
  exit 1
fi
exit 0
